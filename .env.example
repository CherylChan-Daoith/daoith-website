# 复制为 .env 并填入密钥
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# Dify 考试知识库（可选，也可在页面设置中填写）
DIFY_API_KEY=app-your-dify-key
DIFY_API_BASE=http://localhost/v1

# 左侧「查询出口退税率」：Dataset Retrieve（dataset-...，不是 app-...）
DIFY_DATASET_API_KEY=dataset-your-dataset-key
DIFY_HS_REFUND_DATASET_ID=ed8d40b7-9133-4691-a4ba-51f99825e62d

# 微信开放平台 — 网站应用扫码登录
# https://open.weixin.qq.com/
WECHAT_APP_ID=wx_placeholder_app_id
WECHAT_APP_SECRET=your-wechat-app-secret-placeholder
# 授权回调页（须与微信开放平台配置一致）
WECHAT_REDIRECT_URI=https://www.daoith.com/auth/wechat-callback.html

# JWT 签名密钥（请使用随机长字符串）
JWT_SECRET=your-jwt-secret-placeholder

# 用户数据库：共用 Dify Docker Compose 自带的 PostgreSQL
# 先在 Postgres 中新建库 daoith_users，再填写连接串（勿用 Dify 业务库 dify）
# 示例（同机 Docker）：
# DATABASE_URL=postgresql://postgres:difyai123456@127.0.0.1:5432/daoith_users
# 若 Vercel 无法直连内网 Postgres，请把登录 API 部署在同一台阿里云服务器上。
DATABASE_URL=postgresql://postgres:your-postgres-password@127.0.0.1:5432/daoith_users
# 需要 SSL 时再设：
# DATABASE_SSL=true
