{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DaoithDiagnosisReport",
  "description": "道一专属合规诊断报告结构化输出（官网 renderDiagnosisReportJson 渲染）",
  "type": "object",
  "required": ["version", "risk", "plan", "actions", "notes"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema 版本，固定为 1"
    },
    "changes": {
      "type": "array",
      "description": "报告生成后的追问：本轮变化点（可选）",
      "items": {
        "type": "object",
        "required": ["field", "from", "to"],
        "properties": {
          "field": { "type": "string", "description": "字段名，如「产品类别」" },
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "impact": {
      "type": "string",
      "description": "变化点对退税/架构/税负的影响说明（可选）"
    },
    "risk": {
      "type": "object",
      "required": ["processFlow"],
      "properties": {
        "processFlow": {
          "type": "string",
          "description": "业务流程箭头链：供应商发票 → 店铺主体 → 出口方式 → 发货方式 → 平台 → 境外消费者"
        },
        "summary": {
          "type": "string",
          "description": "主要风险一句话概括（可选）"
        },
        "stages": {
          "type": "array",
          "description": "按 01/02/03 三大环节展开的风险条",
          "items": {
            "type": "object",
            "required": ["num", "title", "items"],
            "properties": {
              "num": { "type": "string", "enum": ["01", "02", "03"] },
              "title": {
                "type": "string",
                "enum": [
                  "供应商发票和产品环节",
                  "报关出口环节",
                  "境外销售环节"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["title", "body"],
                      "properties": {
                        "title": { "type": "string" },
                        "body": { "type": "string" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["intro", "overview", "details"],
      "properties": {
        "intro": {
          "type": "string",
          "description": "开篇业务画像一句，如「您属于…，核心合规路径如下：」"
        },
        "overview": {
          "type": "array",
          "description": "三大环节短事项概览（官网渲染为三列流程）",
          "items": {
            "type": "object",
            "required": ["num", "title", "items"],
            "properties": {
              "num": { "type": "string" },
              "title": { "type": "string" },
              "items": {
                "type": "array",
                "items": { "type": "string" },
                "description": "每条尽量一行短标题，不加长说明"
              }
            }
          }
        },
        "details": {
          "type": "array",
          "description": "合规方案细则，连续排列，不要再分 01/02/03 小标题",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["title", "body"],
            "properties": {
              "title": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" },
      "description": "行动建议，连续 1/2/3…，不要分环节"
    },
    "notes": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" },
      "description": "注意事项项目符号"
    },
    "closing": {
      "type": "string",
      "description": "结尾句，固定引导专家1v1"
    }
  }
}
